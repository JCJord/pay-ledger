datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  CUSTOMER_WALLET
  MERCHANT_RECEIVABLE
  SYSTEM_ESCROW
  PLATFORM_FEE
}

enum EntryType {
  DEBIT
  CREDIT
}

model Account {
  id                String                  @id @default(uuid())
  accountNumber     String                  @unique
  userId            String
  ownerName         String
  ownerEmail        String
  type              AccountType             @default(CUSTOMER_WALLET)
  currency          String                  @default("BRL")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  balanceSnapshot   AccountBalanceSnapshot?
  ledgerProjections LedgerEntryProjection[]
}

model AccountBalanceSnapshot {
  id           String   @id @default(uuid())
  accountId    String   @unique
  totalCredits Decimal  @default(0) @db.Decimal(12, 2)
  totalDebits  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model LedgerEntryProjection {
  id        String    @id
  accountId String
  invoiceId String
  type      EntryType
  amount    Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
